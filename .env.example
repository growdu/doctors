# =============================================================================
# Doctors 平台 · 环境变量模板（.env.example）
# -----------------------------------------------------------------------------
# 用法：
#   1. 本文件作为模板 —— 复制为 .env / .env.prod，再覆盖真实密钥。
#   2. .env.* 文件本身已加入 .gitignore，**严禁提交**真实密钥。
#   3. docker-compose 读取格式：env_file: .env （仅中间件生效）。
#   4. 11 个 Go 服务通过 shell 启动时会自动加载 .env；
#      docker 启动时由 docker-compose.deploy.yml 的 environment: 段直接注入，
#      此时本文件仅作为"应该注入哪些变量"的文档参考。
#
# 命名规范（与 shared/config/loader.go 严格对齐）：
#   - DOCTORS_<SVC>_*     每个 Go 服务独立的运行时配置
#   - 中间件环境变量       直接用官方镜像约定名（POSTGRES_PASSWORD / KAFKA_* / REDIS_*）
#
# 11 个服务：auth / order / match / message / payment / review / sos /
#             user / escort / wallet / admin
# =============================================================================

# -----------------------------------------------------------------------------
# 公共：日志/追踪/版本（所有服务一致；按需改成各服务独立）
# -----------------------------------------------------------------------------
# 日志级别（debug | info | warn | error）
DOCTORS_LOGGING_LEVEL=info

# OTel OTLP 导出端点（Jaeger / otel-collector）
#   dev：留空 → Noop
#   prod：otel-collector.observability:4318
DOCTORS_TRACING_OTLP_ENDPOINT=

# 采样率（0~1；0=NeverSample，1=AlwaysSample，生产建议 0.1）
DOCTORS_TRACING_SAMPLING_RATIO=0.1

# 服务构建版本（注入 OTel resource.service.version + Prometheus service_info{version}）
DOCTORS_SERVICE_VERSION=v1.4.0

# Prometheus /metrics 端点开关（true=启用）
DOCTORS_METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# auth-service  · 端口 8081
# -----------------------------------------------------------------------------
DOCTORS_AUTH_HTTP_ADDR=:8080
DOCTORS_AUTH_DB_DSN=postgres://doctors:CHANGE_ME@postgres:5432/doctors?sslmode=disable
DOCTORS_AUTH_REDIS_ADDR=redis:6379
DOCTORS_AUTH_KAFKA_BROKERS=kafka:9092
DOCTORS_AUTH_KAFKA_GROUP_ID=auth-service
DOCTORS_AUTH_JWT_SECRET=CHANGE_ME_USE_openssl_rand_-hex_32
DOCTORS_AUTH_LOGGING_LEVEL=info
DOCTORS_AUTH_TRACING_OTLP_ENDPOINT=
DOCTORS_AUTH_TRACING_SAMPLING_RATIO=0.1
DOCTORS_AUTH_SERVICE_VERSION=v1.4.0
DOCTORS_AUTH_METRICS_ENABLED=true

