DOCTORS_ADMIN_REFUND_BASE_URL=http://review-service:8080
DOCTORS_ADMIN_ESCORT_BASE_URL=http://escort-service:8080
DOCTORS_ADMIN_USER_BASE_URL=http://user-service:8080

# =============================================================================
# 中间件环境变量（docker-compose 启动时注入给 postgres / redis / kafka 容器）
# 这些变量**不是** Go 服务直接读取，是中间件镜像的"约定环境变量"。
# =============================================================================

# PostgreSQL 超级用户密码（dev 默认 doctors；生产必须替换为强密码）
POSTGRES_PASSWORD=CHANGE_ME

# Kafka broker 列表（docker-compose 内为单一 host，跨集群用逗号分隔）
KAFKA_BROKERS=kafka:9092

# Redis 连接串（docker-compose 内 redis://redis:6379）
REDIS_URL=redis://redis:6379

# Jaeger OTLP 端点（dev 用 docker，prod 指向 OTel collector）
JAEGER_OTLP_ENDPOINT=http://jaeger:4318
