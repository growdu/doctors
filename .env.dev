# =============================================================================
# Doctors 平台 · 本地 dev 默认值（.env.dev）
# -----------------------------------------------------------------------------
# ⚠️  仅用于本地 docker-compose / 单服务开发，**不包含任何真实密钥**。
#   - JWT_SECRET 全部为 dev 占位符（dev-secret-change-me）。
#   - PG 密码为 dev 默认（doctors / doctors）。
#   - 启动时 docker-compose 会把对应段注入到容器 ENV。
#   - 本文件**可提交**仓库（与 .env 区别对待），用于"开箱即跑"约定。
#
# 生产环境必须替换本文件，重新生成所有密钥并通过 secret store 注入，
# 详见 docs/ops/secrets.md。
# =============================================================================

# 11 个 Go 服务共用默认值（dev 友好；JWT 全部相同，便于联调）
# 注：DB / Redis / Kafka 用容器名解析；JWT 统一一个便于联调；
#     真实部署每服务 MUST 独立 JWT_SECRET（避免一个 token 签发全网通过）。

LOG_LEVEL=info

# 服务端口（容器内 8080 通过 host 端口映射见 docker-compose.deploy.yml）
AUTH_HTTP_ADDR=:8080
ORDER_HTTP_ADDR=:8080
MATCH_HTTP_ADDR=:8080
MESSAGE_HTTP_ADDR=:8080
PAYMENT_HTTP_ADDR=:8080
REVIEW_HTTP_ADDR=:8080
SOS_HTTP_ADDR=:8080
USER_HTTP_ADDR=:8080
ESCORT_HTTP_ADDR=:8080
WALLET_HTTP_ADDR=:8080
ADMIN_HTTP_ADDR=:8080

# PostgreSQL DSN（dev：doctors 用户 + doctors 库；容器名 postgres）
DB_DSN_AUTH=postgres://doctors:doctors@postgres:5432/doctors?sslmode=disable
DB_DSN_ORDER=postgres://doctors:doctors@postgres:5432/doctors?sslmode=disable
DB_DSN_MATCH=postgres://doctors:doctors@postgres:5432/doctors?sslmode=disable
DB_DSN_MESSAGE=postgres://doctors:doctors@postgres:5432/doctors?sslmode=disable
DB_DSN_PAYMENT=postgres://doctors:doctors@postgres:5432/doctors?sslmode=disable
DB_DSN_REVIEW=postgres://doctors:doctors@postgres:5432/doctors?sslmode=disable
DB_DSN_SOS=postgres://doctors:doctors@postgres:5432/doctors?sslmode=disable
DB_DSN_USER=postgres://doctors:doctors@postgres:5432/doctors?sslmode=disable
DB_DSN_ESCORT=postgres://doctors:doctors@postgres:5432/doctors?sslmode=disable
DB_DSN_WALLET=postgres://doctors:doctors@postgres:5432/doctors?sslmode=disable
DB_DSN_ADMIN=postgres://doctors:doctors@postgres:5432/doctors?sslmode=disable

# Redis（容器内）
REDIS_AUTH=redis:6379
REDIS_ORDER=redis:6379
REDIS_MATCH=redis:6379
REDIS_MESSAGE=redis:6379
REDIS_PAYMENT=redis:6379
REDIS_REVIEW=redis:6379
REDIS_SOS=redis:6379
REDIS_USER=redis:6379
REDIS_ESCORT=redis:6379
REDIS_WALLET=redis:6379
REDIS_ADMIN=redis:6379

# Kafka（容器内）
KAFKA_AUTH_BROKERS=kafka:9092
KAFKA_AUTH_GROUP=auth-service
KAFKA_ORDER_BROKERS=kafka:9092
KAFKA_ORDER_GROUP=order-service
KAFKA_MATCH_BROKERS=kafka:9092
KAFKA_MATCH_GROUP=match-service
KAFKA_MESSAGE_BROKERS=kafka:9092
KAFKA_MESSAGE_GROUP=message-service
KAFKA_PAYMENT_BROKERS=kafka:9092
KAFKA_PAYMENT_GROUP=payment-service
KAFKA_REVIEW_BROKERS=kafka:9092
KAFKA_REVIEW_GROUP=review-service
KAFKA_SOS_BROKERS=kafka:9092
KAFKA_SOS_GROUP=sos-service
KAFKA_USER_BROKERS=kafka:9092
KAFKA_USER_GROUP=user-service
KAFKA_ESCORT_BROKERS=kafka:9092
KAFKA_ESCORT_GROUP=escort-service
KAFKA_WALLET_BROKERS=kafka:9092
KAFKA_WALLET_GROUP=wallet-service
KAFKA_ADMIN_BROKERS=kafka:9092
KAFKA_ADMIN_GROUP=admin-service

# JWT 密钥（dev 占位 —— **严禁生产复用**）
# 生产 MUST 用：openssl rand -hex 32  替换每个服务独立密钥
JWT_SECRET_DEV=dev-secret-change-me

# 中间件（注入到 docker-compose 容器）
POSTGRES_USER=doctors
POSTGRES_PASSWORD=doctors
POSTGRES_DB=doctors
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092
JAEGER_OTLP_ENDPOINT=http://jaeger:4318

# admin 内部 baseURL（容器名 + 服务端口）
ADMIN_ORDER_BASE_URL=http://order-service:8080
ADMIN_REFUND_BASE_URL=http://review-service:8080
ADMIN_ESCORT_BASE_URL=http://escort-service:8080
ADMIN_USER_BASE_URL=http://user-service:8080

# 公共
TRACING_OTLP_ENDPOINT=http://jaeger:4318
TRACING_SAMPLING_RATIO=1.0
SERVICE_VERSION=v1.4.0-dev
METRICS_ENABLED=true
