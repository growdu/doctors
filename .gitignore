# Binaries
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test
*.test
*.out
coverage.html

# Go workspace
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.iml

# Env
#   - 默认忽略所有 .env* 文件（防误提交真实密钥）
#   - 但 .env.example / .env.dev 是模板文件 / dev 默认值，**必须可提交**
#   - 真实 .env / .env.prod / .env.staging / ... 必须保持被忽略
.env*
!.env.example
!.env.dev

# Local data
/.data/
/tmp/

# Generated
/site/        # mkdocs build 输出（CI 重新构建）
/sqlc/
/gen/

# Logs
*.log

# OS
.DS_Store
Thumbs.dbsite/
venv/
__pycache__/
*.pyc

# JS / TS workspace 根目录污染防护
#   - 任何子项目误把依赖提到 doctors 根时（pnpm 误判等），不应被误 commit
#   - 子项目自己的 node_modules / package.json 由其本地 .gitignore 接管
/node_modules/
/package.json
/pnpm-lock.yaml
/test-results/
/playwright-report/
/cmd
